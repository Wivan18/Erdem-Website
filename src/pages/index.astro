---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="IONIC — Data Analytics & Business Intelligence. We transform raw operational data into actionable intelligence for East African businesses, SACCOs, and NGOs.">

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="section-label" style="color:var(--cyan);">Data Analytics & Business Intelligence</p>
        <h1>Your data is running your business.<br /><span class="hero-accent">Are you running it?</span></h1>
        <p class="hero-sub">
          Most organizations in East Africa are data-rich but insight-poor. IONIC transforms
          raw, scattered data into clear dashboards, automated reports, and predictive models —
          delivered on retainer, not on request.
        </p>
        <div class="hero-actions">
          <a href="/case-studies" class="btn btn-primary">See Our Work</a>
          <a href="/contact" class="btn btn-white">Talk to Us</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card">
          <div class="hero-stat">
            <span class="stat-num">7 days</span>
            <span class="stat-arrow">→</span>
            <span class="stat-num accent">1 hour</span>
          </div>
          <p class="stat-label">Monthly reporting time for a Nairobi manufacturer</p>
        </div>
        <div class="hero-card">
          <div class="hero-stat">
            <span class="stat-num accent">31%</span>
          </div>
          <p class="stat-label">Reduction in loan defaults for a SACCO using our predictive model</p>
        </div>
        <div class="hero-card">
          <div class="hero-stat">
            <span class="stat-num accent">20+</span>
          </div>
          <p class="stat-label">Staff hours saved per month through AI-driven automation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ────────────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <p class="section-label" style="text-align:center;">The Problem We Solve</p>
      <h2 style="text-align:center; max-width:600px; margin:0 auto 48px;">You have the data. You just can't see it clearly.</h2>
      <div class="problem-grid">
        <div class="problem-item">
          <div class="problem-icon">📊</div>
          <h3>Scattered Data</h3>
          <p>Reports live in disconnected spreadsheets, paper registers, and email threads. Getting a single view of your business takes days.</p>
        </div>
        <div class="problem-item">
          <div class="problem-icon">⏱</div>
          <h3>Manual Reporting</h3>
          <p>Your team spends weeks compiling reports that are already outdated by the time they reach management. No pipeline — just effort.</p>
        </div>
        <div class="problem-item">
          <div class="problem-icon">🔮</div>
          <h3>No Forward Visibility</h3>
          <p>You react to problems after they happen. Without predictive models, defaults, stockouts, and revenue dips only appear once the damage is done.</p>
        </div>
        <div class="problem-item">
          <div class="problem-icon">📍</div>
          <h3>No Intelligence Layer</h3>
          <p>Data exists but nothing converts it into alerts, decisions, or strategy. The gap between your data and your decisions is costing you money.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── POSITIONING ────────────────────────────────────────────── -->
  <section class="section section-dark">
    <div class="container positioning-inner">
      <div>
        <p class="section-label" style="color:var(--cyan);">How IONIC Is Different</p>
        <h2 style="color:var(--white); margin-bottom:24px;">A platform partner, not a one-off consultant.</h2>
        <p style="color:rgba(255,255,255,0.75); font-size:1.05rem; max-width:480px; line-height:1.8;">
          We don't build dashboards on request and disappear. IONIC embeds in your operations
          on a monthly retainer — becoming a recurring part of how you monitor performance,
          catch problems early, and plan ahead. Our methodology and white-labeled architecture
          are your competitive advantage.
        </p>
        <a href="/who-we-serve" class="btn btn-white" style="margin-top:32px;">See Who We Work With</a>
      </div>
      <div class="positioning-stats">
        <div class="pos-stat">
          <span class="pos-num">3</span>
          <span class="pos-label">Client tiers served — SACCOs, SMEs, NGOs</span>
        </div>
        <div class="pos-stat">
          <span class="pos-num">6</span>
          <span class="pos-label">Integrated service lines</span>
        </div>
        <div class="pos-stat">
          <span class="pos-num">East Africa</span>
          <span class="pos-label">Based in Nairobi. Built for the region.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <p class="section-label">What We Do</p>
      <h2 style="margin-bottom:8px;">Six integrated service lines.</h2>
      <div class="divider"></div>
      <div class="services-grid">
        <a href="/services#dashboards" class="card service-card">
          <div class="service-num">01</div>
          <h3>Business Dashboards & Analysis</h3>
          <p>Turn spreadsheets into live, interactive reports. Sales, inventory, loans, branch performance — in one place, updated automatically.</p>
          <span class="service-tag">Anchor Service</span>
        </a>
        <a href="/services#automation" class="card service-card">
          <div class="service-num">02</div>
          <h3>AI Agents & Data Automation</h3>
          <p>Let AI handle repetitive data tasks — report generation, alert triggers, feedback analysis, and data entry elimination.</p>
          <span class="service-tag">Saves 20+ hrs/month</span>
        </a>
        <a href="/services#predictive" class="card service-card">
          <div class="service-num">03</div>
          <h3>Predictive Modeling</h3>
          <p>Forecast next quarter's sales, anticipate stock needs, or score loan default risk — before it becomes a problem.</p>
          <span class="service-tag">Plan Ahead</span>
        </a>
        <a href="/services#location" class="card service-card">
          <div class="service-num">04</div>
          <h3>Location-Based Insights</h3>
          <p>Compare branch and regional performance on a map. See where your business thrives and where to grow next.</p>
          <span class="service-tag">Multi-Branch</span>
        </a>
        <a href="/services#survey" class="card service-card">
          <div class="service-num">05</div>
          <h3>Survey & Feedback Analysis</h3>
          <p>Reduce weeks of manual analysis to hours. AI surfaces clear themes from open-ended responses.</p>
          <span class="service-tag">NGO & Research</span>
        </a>
        <a href="/services#data" class="card service-card">
          <div class="service-num">06</div>
          <h3>Data Collection & Organization</h3>
          <p>Digital forms, structured databases, and automated pipelines that make your data clean and ready for analysis.</p>
          <span class="service-tag">Foundation Layer</span>
        </a>
      </div>
      <div style="text-align:center; margin-top:48px;">
        <a href="/services" class="btn btn-outline">Explore All Services</a>
      </div>
    </div>
  </section>

  <!-- ── CASE STUDIES ───────────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <p class="section-label">Our Work</p>
      <h2 style="margin-bottom:8px;">Results that speak for themselves.</h2>
      <div class="divider"></div>
      <div class="cases-grid">
        <a href="/case-studies/feed-manufacturer" class="card case-card">
          <span class="tag tag-teal" style="margin-bottom:16px;">Manufacturing</span>
          <h3>From Paper Registers to Remote-Ready Dashboards</h3>
          <p>A Nairobi animal feed manufacturer reduced monthly reporting from 7 days to 1 hour and now runs their business fully remotely.</p>
          <div class="case-metric">
            <span class="metric-val">7 days → 1 hr</span>
            <span class="metric-label">Reporting time</span>
          </div>
        </a>
        <a href="/case-studies/insurance" class="card case-card">
          <span class="tag tag-teal" style="margin-bottom:16px;">Insurance</span>
          <h3>Turning Claims Chaos into Compliance Clarity</h3>
          <p>An insurance provider automated claims reporting, flagged 18% of their backlog as suspicious, and gained live branch visibility.</p>
          <div class="case-metric">
            <span class="metric-val">18%</span>
            <span class="metric-label">Fraudulent claims flagged</span>
          </div>
        </a>
        <a href="/case-studies/sacco" class="card case-card">
          <span class="tag tag-teal" style="margin-bottom:16px;">SACCO</span>
          <h3>From Ledger Books to Loan Intelligence</h3>
          <p>A Kenyan SACCO automated SASRA compliance, built a default prediction model, and reduced loan defaults by 31% in six months.</p>
          <div class="case-metric">
            <span class="metric-val">31%</span>
            <span class="metric-label">Default rate reduction</span>
          </div>
        </a>
      </div>
      <div style="text-align:center; margin-top:48px;">
        <a href="/case-studies" class="btn btn-primary">View All Case Studies</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────────── -->
  <section class="section cta-section">
    <div class="container" style="text-align:center;">
      <p class="section-label" style="color:var(--cyan);">Get Started</p>
      <h2 style="color:var(--white); max-width:560px; margin:0 auto 16px;">Ready to see what your data can do?</h2>
      <p style="max-width:480px; margin:0 auto 40px; font-size:1.05rem; color:rgba(255,255,255,0.75);">
        Tell us about your organization and we will show you exactly what an IONIC engagement looks like for your sector.
      </p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="btn btn-white">Talk to Us</a>
        <a href="/case-studies" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4); color:var(--white);">See Case Studies</a>
      </div>
    </div>
  </section>

</Layout>

<style>
.hero { background: linear-gradient(135deg, var(--teal-dark) 0%, #0a4a56 100%); padding: 100px 0 80px; color: var(--white); }
.hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.hero-content h1 { color: var(--white); margin-bottom: 20px; }
.hero-accent { color: var(--cyan); }
.hero-sub { color: rgba(255,255,255,0.80); font-size: 1.05rem; max-width: 480px; margin-bottom: 36px; }
.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
.hero-visual { display: flex; flex-direction: column; gap: 16px; }
.hero-card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-md); padding: 20px 24px; }
.hero-stat { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
.stat-num { font-size: 1.6rem; font-weight: 700; color: var(--white); }
.stat-num.accent { color: var(--cyan); }
.stat-arrow { color: var(--cyan); font-size: 1.2rem; }
.stat-label { color: rgba(255,255,255,0.65); font-size: 0.88rem; }
.problem-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
.problem-item { text-align: center; padding: 32px 24px; }
.problem-icon { font-size: 2.2rem; margin-bottom: 16px; }
.problem-item h3 { margin-bottom: 10px; color: var(--teal-dark); }
.positioning-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.positioning-stats { display: flex; flex-direction: column; gap: 32px; }
.pos-stat { border-left: 3px solid var(--cyan); padding-left: 20px; }
.pos-num { display: block; font-size: 2rem; font-weight: 700; color: var(--cyan); }
.pos-label { font-size: 0.9rem; color: rgba(255,255,255,0.7); }
.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 40px; }
.service-card { display: block; text-decoration: none; color: inherit; }
.service-num { font-size: 0.75rem; font-weight: 700; color: var(--teal-bright); letter-spacing: 0.1em; margin-bottom: 12px; }
.service-card h3 { color: var(--teal-dark); margin-bottom: 10px; }
.service-tag { display: inline-block; margin-top: 16px; font-size: 0.75rem; font-weight: 600; color: var(--teal-mid); background: #E0F5F5; padding: 3px 10px; border-radius: 99px; }
.cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 40px; }
.case-card { display: block; color: inherit; }
.case-card h3 { color: var(--teal-dark); margin-bottom: 10px; }
.case-metric { margin-top: 20px; padding-top: 16px; border-top: 1px solid #E5E7EB; }
.metric-val { display: block; font-size: 1.4rem; font-weight: 700; color: var(--teal-mid); }
.metric-label { font-size: 0.82rem; color: var(--gray-mid); }
.cta-section { background: var(--teal-dark); }
@media (max-width: 768px) {
  .hero-inner { grid-template-columns: 1fr; gap: 40px; }
  .positioning-inner { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
}
</style>
