---
import Layout from '../layouts/Layout.astro';
const svcs=[
  {num:'01',id:'dashboards',img:'/images/service-01.jpg',title:'Business Dashboards & Analysis',tagline:'Turn your spreadsheets into simple, visual reports.',desc:'We build clear, interactive dashboards in Power BI and Looker Studio that replace manual Excel updates. Real-time visibility into sales, inventory, branch performance, and loan portfolios — all in one place, updated automatically.',why:'Anchor service — entry point for most client relationships.',tags:['SACCOs','Manufacturing','Multi-Branch Retail','NGOs']},
  {num:'02',id:'automation',img:'/images/service-02.jpg',title:'AI Agents & Data Automation',tagline:'Let AI handle the repetitive work.',desc:'Smart AI agents that automate routine data tasks — generating reports, analyzing customer feedback, sending alerts when sales shift or stock runs low, and eliminating manual data entry.',why:'Saves clients 20+ staff hours per month.',tags:['All Sectors','Finance','Distribution']},
  {num:'03',id:'predictive',img:'/images/service-03.jpg',title:'Predictive Modeling',tagline:'Plan ahead with confidence.',desc:"Forecasting models for next quarter's sales, future stock needs, and loan default risk. Designed to be interpretable and actionable, not just technically sophisticated.",why:'Critical for financial institutions managing credit risk and SMEs managing inventory.',tags:['SACCOs','Microfinance','Agribusiness']},
  {num:'04',id:'location',img:'/images/service-04.jpg',title:'Location-Based Business Insights',tagline:'Know where your business performs best.',desc:'Geospatial data mapping to compare performance across branches or regions. See which areas are thriving, where opportunities are being lost, and where to grow next.',why:'Strong differentiator for multi-branch retail, distribution networks, and regional NGO programs.',tags:['Multi-Branch Retail','Distribution','NGOs']},
  {num:'05',id:'survey',img:'/images/service-05.jpg',title:'Survey & Feedback Analysis',tagline:'Turn opinions into insights you can act on.',desc:'We analyze survey responses, customer feedback, and community interviews using AI to surface clear themes. Ideal for NGOs producing donor reports or businesses improving their products.',why:'Reduces weeks of manual analysis to hours.',tags:['NGOs','Development Organizations','Research']},
  {num:'06',id:'data',img:'/images/service-06.jpg',title:'Data Collection & Organization',tagline:'Set the foundation for good decisions.',desc:'Digital forms, simple databases, and automated collection pipelines that ensure your data is clean, consistent, and ready for analysis.',why:'Often the prerequisite before dashboards can be built — creates immediate stickiness.',tags:['NGOs','SMEs','Field Programs']},
];
---
<Layout title="Services" description="Erdem offers six integrated data analytics and BI service lines for East African businesses, SACCOs, and NGOs.">
  <section class="page-hero">
    <div class="container">
      <span class="label">What We Do</span>
      <h1>Six service lines.<br/><span class="cyan">One platform partner.</span></h1>
      <p style="margin-top:16px;max-width:520px;">Each service stands alone or layers with others as your needs mature. Most relationships start with dashboards and grow from there.</p>
    </div>
  </section>
  <section class="section">
    <div class="container" style="display:flex;flex-direction:column;gap:48px;">
      {svcs.map((s,i)=>(
        <div class="fade-up" id={s.id} style={`display:grid;grid-template-columns:${i%2===0?'340px 1fr':'1fr 340px'};gap:48px;align-items:center;padding-bottom:48px;border-bottom:1px solid var(--border);`}>
          <div style={i%2===0?'':'order:2'}>
            <img src={s.img} alt={s.title} style="width:100%;height:240px;object-fit:cover;border-radius:var(--r-lg);border:1px solid var(--b-cyan);display:block;"/>
          </div>
          <div style={i%2===0?'':'order:1'}>
            <span class="label">{s.num}</span>
            <h2 style="font-size:1.6rem;margin-bottom:8px;">{s.title}</h2>
            <p style="color:var(--cyan);font-style:italic;margin-bottom:14px;font-size:0.95rem;">{s.tagline}</p>
            <p style="margin-bottom:16px;">{s.desc}</p>
            <div class="accent-bar" style="margin-bottom:16px;">{s.why}</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">{s.tags.map(t=><span class="tag">{t}</span>)}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section s-mid" style="text-align:center;">
    <div class="container">
      <h2 style="margin-bottom:14px;">Not sure which service fits?</h2>
      <p style="color:var(--muted);max-width:440px;margin:0 auto 32px;">Tell us about your organization and we'll recommend exactly where to start.</p>
      <a href="/contact" class="btn btn-cyan">Talk to Us →</a>
    </div>
  </section>
</Layout>
<style>
@media(max-width:900px){[style*="grid-template-columns:340px 1fr"],[style*="grid-template-columns:1fr 340px"]{grid-template-columns:1fr!important}[style*="order:2"],[style*="order:1"]{order:unset!important}}
</style>
