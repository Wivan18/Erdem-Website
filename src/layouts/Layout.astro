---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Erdem Analytics — Data Analytics & Business Intelligence for East Africa. We transform raw data into clear dashboards, automated reports, and predictive models.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Erdem Analytics</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>

  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/ionic-lockup-horizontal.png" alt="Erdem Analytics" />
      </a>
      <ul class="nav-links" id="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/blog">Insights</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <div class="nav-cta-wrap">
        <a href="/contact" class="btn btn-cyan">Talk to Us</a>
      </div>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <main><slot /></main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <img src="/images/ionic-mark-reversed.png" alt="Erdem" style="height:36px;margin-bottom:18px;" />
          <p style="font-size:0.87rem;color:var(--text-muted);max-width:280px;line-height:1.8;">
            Data Analytics & Business Intelligence for organizations across East Africa.
            On retainer, not on request.
          </p>
        </div>
        <div>
          <h4>Services</h4>
          <ul class="footer-links">
            <li><a href="/services#dashboards">Business Dashboards</a></li>
            <li><a href="/services#automation">AI & Automation</a></li>
            <li><a href="/services#predictive">Predictive Modeling</a></li>
            <li><a href="/services#location">Location Insights</a></li>
            <li><a href="/services#survey">Survey Analysis</a></li>
            <li><a href="/services#data">Data Collection</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul class="footer-links">
            <li><a href="/case-studies">Case Studies</a></li>
            <li><a href="/blog">Insights</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Erdem Labs Limited. Nairobi, Kenya.</span>
        <span style="color:var(--cyan);font-weight:600;">erdem.co.ke</span>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const links  = document.getElementById('nav-links');
    toggle?.addEventListener('click', () => links?.classList.toggle('open'));

    // Scroll-triggered animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
  </script>

  <style is:global>
    .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .fade-up:nth-child(2) { transition-delay: 0.1s; }
    .fade-up:nth-child(3) { transition-delay: 0.2s; }
    .fade-up:nth-child(4) { transition-delay: 0.3s; }
    .fade-up:nth-child(5) { transition-delay: 0.4s; }
    .fade-up:nth-child(6) { transition-delay: 0.5s; }
  </style>
</body>
</html>
