---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'IONIC — Data Analytics & Business Intelligence. We transform raw data into actionable intelligence for organizations across East Africa.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | IONIC — Data Analytics & Business Intelligence</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/ionic-lockup-horizontal.png" alt="IONIC" />
      </a>
      <ul class="nav-links" id="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/who-we-serve">Who We Serve</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/blog">Insights</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <a href="/contact" class="btn btn-primary nav-cta">Talk to Us</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- PAGE CONTENT -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <img src="/images/ionic-mark-reversed.png" alt="IONIC" style="height:40px; margin-bottom:16px;" />
          <p style="font-size:0.9rem; max-width:300px; line-height:1.8;">
            Data Analytics & Business Intelligence for organizations across East Africa.
            We turn raw data into decisions — on retainer, not on request.
          </p>
        </div>
        <div>
          <h4>Services</h4>
          <ul class="footer-links">
            <li><a href="/services#dashboards">Business Dashboards</a></li>
            <li><a href="/services#automation">AI & Automation</a></li>
            <li><a href="/services#predictive">Predictive Modeling</a></li>
            <li><a href="/services#location">Location Insights</a></li>
            <li><a href="/services#survey">Survey Analysis</a></li>
            <li><a href="/services#data">Data Collection</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul class="footer-links">
            <li><a href="/who-we-serve">Who We Serve</a></li>
            <li><a href="/case-studies">Case Studies</a></li>
            <li><a href="/blog">Insights</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} IONIC Data Analytics & Business Intelligence. Nairobi, Kenya.</span>
        <span style="color:var(--cyan);">ionic.co.ke</span>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav toggle
    const toggle = document.getElementById('nav-toggle');
    const links  = document.getElementById('nav-links');
    toggle?.addEventListener('click', () => links?.classList.toggle('open'));
  </script>

</body>
</html>
